# Endereço público do Grafana (sem https://)
GRAFANA_HOST=monitor.rlcsolucoes.com.br
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Alertas do Grafana
TELEGRAM_BOT_TOKEN=
# O chat id fica em grafana/provisioning/alerting/contato.yml

# Senha dos agentes. Gere o hash com:
#   docker run --rm caddy:2.9.1-alpine caddy hash-password --plaintext 'SENHA'
# e cole ENTRE ASPAS SIMPLES (o hash tem "$", que o compose interpretaria).
INGEST_USER=agente
INGEST_PASSWORD_HASH=''

# Token do túnel Cloudflare "monitoramento" (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

RETENCAO_METRICAS=30d
