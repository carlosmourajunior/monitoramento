  {
   "id": 13,
   "type": "table",
   "title": "Containers reiniciados recentemente (início do processo)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 30,
    "w": 24,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sort_desc(time() - max by (servidor, name) (container_start_time_seconds{name!=\"\",servidor=~\"$servidor\"}) < 86400)",
     "instant": true,
     "queryType": "instant",
     "legendFormat": ""
    }
   ],
   "transformations": [
    {
     "id": "reduce",
     "options": {
      "reducers": [
       "lastNotNull"
      ],
      "labelsToFields": true
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Field": true
      },
      "renameByName": {
       "Last *": "Total",
       "Last": "Total"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Total",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
