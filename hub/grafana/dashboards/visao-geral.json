{
 "uid": "visao-geral",
 "title": "Visão geral",
 "tags": [
  "monitoramento"
 ],
 "timezone": "America/Sao_Paulo",
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "templating": {
  "list": [
   {
    "name": "servidor",
    "label": "Servidor",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up{job=\"host\"}, servidor)",
     "refId": "q"
    },
    "definition": "label_values(up{job=\"host\"}, servidor)",
    "includeAll": true,
    "multi": true,
    "allValue": ".+",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Servidores",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Mandando dados",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (servidor) (up{job=\"host\",servidor=~\"$servidor\"})",
     "legendFormat": "{{servidor}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "PARADO"
        },
        "1": {
         "text": "OK"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value_and_name",
    "graphMode": "none"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Ligado há",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "time() - max by (servidor) (node_boot_time_seconds{servidor=~\"$servidor\"})",
     "legendFormat": "{{servidor}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value_and_name",
    "graphMode": "none"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Disco /",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (servidor) (100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",servidor=~\"$servidor\"} / node_filesystem_size_bytes{mountpoint=\"/\",servidor=~\"$servidor\"}))",
     "legendFormat": "{{servidor}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 75
       },
       {
        "color": "red",
        "value": 85
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value_and_name",
    "graphMode": "none"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "IPs bloqueados (CrowdSec)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (servidor) (cs_active_decisions{servidor=~\"$servidor\"}) or (max by (servidor) (up{job=\"crowdsec\",servidor=~\"$servidor\"}) == 1) * 0",
     "legendFormat": "{{servidor}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value_and_name",
    "graphMode": "none"
   },
   "description": "IPs com bloqueio ativo agora. 0 = CrowdSec rodando sem bloqueios; sem dado = CrowdSec não instalado ou parado."
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * (1 - avg by (servidor) (rate(node_cpu_seconds_total{mode=\"idle\",servidor=~\"$servidor\"}[$__rate_interval])))",
     "legendFormat": "{{servidor}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     },
     "max": 100,
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
